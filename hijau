            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">No. Telefon</label>
              <input type="tel" required value={phone} onChange={e => setPhone(e.target.value)} className="w-full border-gray-300 rounded-xl shadow-sm p-3 border focus:ring-green-500 focus:border-green-500" placeholder="0123456789" />
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">Kawasan Penghantaran</label>
              <select value={region} onChange={e => setRegion(e.target.value)} className="w-full border-gray-300 rounded-xl shadow-sm p-3 border focus:ring-green-500 focus:border-green-500 bg-white">
                <option value="SM">Semenanjung Malaysia (RM {storeSettings.feeSM})</option>
                <option value="SS">Sabah / Sarawak (RM {storeSettings.feeSS})</option>
