                    reader.readAsDataURL(file);
                  }
                }} className="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-green-700 hover:file:bg-green-100 mb-2" />
                {storeSettings.qrCodeUrl && <img src={storeSettings.qrCodeUrl} className="h-24 w-24 object-contain border rounded-lg bg-white p-1" alt="QR Preview"/>}
              </div>
            </div>

            <div className="bg-gray-50 p-6 rounded-2xl">
              <h3 className="font-bold mb-4 flex items-center"><Package className="mr-2"/> Harga & Stok Produk</h3>
              <div className="space-y-4">
                {products.map(product => (
                  <div key={product.id} className="flex justify-between items-center bg-white p-4 rounded-xl border">
                    <div className="font-bold w-1/2">{product.name}</div>
                    <div className="flex space-x-2 w-1/2">
                      <input type="number" value={product.price} onChange={(e) => handleProductPriceChange(product.id, e.target.value)} className="w-1/2 border rounded-lg p-2 text-center font-bold text-green-700" placeholder="Harga" />
                      <input type="number" value={product.stock} onChange={(e) => handleProductStockChange(product.id, e.target.value)} className="w-1/2 border rounded-lg p-2 text-center font-bold text-blue-700" placeholder="Stok" />
                    </div>
                  </div>
                ))}
              </div>
            </div>
            
            <div className="bg-gray-50 p-6 rounded-2xl">
              <h3 className="font-bold mb-4 flex items-center"><Activity className="mr-2"/> Google AdSense ID</h3>
              <input type="text" value={storeSettings.adsenseClientId} onChange={(e) => setStoreSettings({...storeSettings, adsenseClientId: e.target.value})} className="w-full border rounded-xl p-4 font-mono text-gray-800" placeholder="ca-pub-xxx" />
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
