    whatsapp: "60123456789",
    feeSM: 8.00,
    feeSS: 15.00,
    freeThreshold: 150.00,
    qrCodeUrl: "",
    adsenseClientId: "ca-pub-0000000000000000",
    bankName: "Maybank - KopiViral",
    accNumber: "162204123456"
  });
  
  const [cart, setCart] = useState([]);
  const [isCartOpen, setIsCartOpen] = useState(false);
  const [popupData, setPopupData] = useState(null);
  
  const [orders, setOrders] = useState([
    { id: 'ORD-001', customer: 'Ali Bin Abu', phone: '0123456789', address: 'Kajang', region: 'SM', total: 120, status: 'Paid', trackingNo: '', receipt: null, date: '2023-10-25' }
  ]);

  useEffect(() => {
    const handleContextMenu = (e) => e.preventDefault();
    const handleKeyDown = (e) => {
      if (e.keyCode === 123 || (e.ctrlKey && e.shiftKey && (e.keyCode === 73 || e.keyCode === 74)) || (e.ctrlKey && e.keyCode === 85)) {
        e.preventDefault(); return false;
      }
    };
    document.addEventListener('contextmenu', handleContextMenu);
    document.addEventListener('keydown', handleKeyDown);
    return () => {
      document.removeEventListener('contextmenu', handleContextMenu);
      document.removeEventListener('keydown', handleKeyDown);
    };
  }, []);

  useEffect(() => {
    document.title = "Kopi Songkok Al Ambiak Original Direct Kilang | Tenaga Maksima";
    window.fbq = window.fbq || function() { console.log('FB Pixel:', arguments); };
    window.gtag = window.gtag || function() { console.log('GA4 Event:', arguments); };
    window.fbq('track', 'PageView');
    window.gtag('event', 'page_view');
  }, []);

  const addToCart = (product) => {
    if (product.stock <= 0) return;
    
    // Pixel Event: AddToCart
    if(window.fbq) window.fbq('track', 'AddToCart', { content_name: product.name, value: product.price, currency: 'MYR' });
    
    setCart(prev => {
      const existing = prev.find(item => item.id === product.id);
      if (existing) {
        if (existing.qty >= product.stock) return prev;
        return prev.map(item => item.id === product.id ? { ...item, qty: item.qty + 1 } : item);
      }
      return [...prev, { ...product, qty: 1 }];
    });
    setIsCartOpen(true);
  };

  const updateQty = (id, delta) => {
    setCart(prev => prev.map(item => {
      if (item.id === id) {
        const productRef = products.find(p => p.id === id);
        const newQty = Math.max(1, Math.min(item.qty + delta, productRef?.stock || 99));
        return { ...item, qty: newQty };
      }
      return item;
    }));
  };

  const removeFromCart = (id) => setCart(prev => prev.filter(item => item.id !== id));
  
  const cartTotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
  const cartCount = cart.reduce((sum, item) => sum + item.qty, 0);

  useEffect(() => {
    if (currentView !== 'shop') return;
    const showRandomPopup = () => {
      const randomName = SOCIAL_PROOF_NAMES[Math.floor(Math.random() * SOCIAL_PROOF_NAMES.length)];
      const randomProduct = products[Math.floor(Math.random() * products.length)].name;
      const randomTime = TIME_AGO[Math.floor(Math.random() * TIME_AGO.length)];
      setPopupData({ name: randomName, product: randomProduct, time: randomTime });
      setTimeout(() => setPopupData(null), 5000);
    };
    const initialTimer = setTimeout(showRandomPopup, 3000);
    const intervalTimer = setInterval(showRandomPopup, 15000);
    return () => { clearTimeout(initialTimer); clearInterval(intervalTimer); };
  }, [currentView, products]);

  const handleCheckoutComplete = (orderData) => {
    const { name, phone, address, region, paymentMethod, grandTotal, receiptBase64 } = orderData;
    
    const newOrderId = `ORD-${Math.floor(Math.random() * 10000)}`;
    const newOrder = {
      id: newOrderId,
      customer: name || 'Guest User',
      phone: phone, address: address, region: region, total: grandTotal,
      status: receiptBase64 ? 'Paid' : 'Pending Verification',
      trackingNo: '', receipt: receiptBase64,
      date: new Date().toISOString().split('T')[0]
    };

    setProducts(prevProducts => prevProducts.map(p => {
      const cartItem = cart.find(c => c.id === p.id);
      return cartItem ? { ...p, stock: Math.max(0, p.stock - cartItem.qty) } : p;
    }));

    // Pixel Event: Purchase (Advanced Matching Simulation)
    if(window.fbq) window.fbq('track', 'Purchase', { value: grandTotal, currency: 'MYR' }, { fn: name, ph: phone });

    // Format WhatsApp Message
    const sellerPhone = storeSettings.whatsapp; 
    let itemsList = cart.map(item => `- ${item.qty}x ${item.name} (RM ${(item.price * item.qty).toFixed(2)})`).join('\n');
    let resitStatus = receiptBase64 ? '\n*Resit Bayaran:* Ya (Dalam sistem)' : '\n*Resit Bayaran:* Sila lampirkan resit di sini';
    
    const waText = `*ORDER BARU DARI WEBSITE (${newOrderId})*\n\n*Maklumat Pelanggan:*\nNama: ${name}\nNo Tel: ${phone}\nKawasan: ${region === 'SM' ? 'Semenanjung' : 'Sabah/Sarawak'}\nAlamat: ${address}\n\n*Senarai Pesanan:*\n${itemsList}\n\n*Jumlah Perlu Dibayar:* RM ${grandTotal.toFixed(2)}\n*Cara Bayaran:* QR Code / Online Transfer${resitStatus}\n\nMohon semak bos. Terima kasih!`;
    const waUrl = `https://wa.me/${sellerPhone}?text=${encodeURIComponent(waText)}`;
    
    window.open(waUrl, '_blank');
    setOrders([newOrder, ...orders]);
    setCart([]);
    setCurrentView('shop');
    setSuccessModal(true);
  };

  return (
    <div className="min-h-screen bg-neutral-50 font-sans text-neutral-800 selection:bg-green-200 selection:text-green-900">
      <Navbar cartCount={cartCount} openCart={() => setIsCartOpen(true)} setView={setCurrentView} currentView={currentView} />

      {currentView === 'shop' && (
        <ShopView addToCart={addToCart} popupData={popupData} products={products} adsenseClientId={storeSettings.adsenseClientId} />
      )}

      {currentView === 'checkout' && (
        <CheckoutView cart={cart} cartTotal={cartTotal} goBack={() => setCurrentView('shop')} completeOrder={handleCheckoutComplete} storeSettings={storeSettings} />
      )}

      {currentView === 'admin' && (
        <AdminView orders={orders} isAuthenticated={isAdminAuthenticated} setAuth={setIsAdminAuthenticated} products={products} setProducts={setProducts} storeSettings={storeSettings} setStoreSettings={setStoreSettings} />
      )}

      <CartSidebar isOpen={isCartOpen} close={() => setIsCartOpen(false)} cart={cart} updateQty={updateQty} removeFromCart={removeFromCart} total={cartTotal} proceedToCheckout={() => { setIsCartOpen(false); setCurrentView('checkout'); }} />

      {/* Modal Berjaya Checkout */}
      {successModal && (
        <div className="fixed inset-0 flex items-center justify-center z-[100] bg-black bg-opacity-50 px-4 backdrop-blur-sm">
          <div className="bg-white p-8 rounded-2xl text-center max-w-sm w-full mx-auto shadow-2xl animate-[scaleIn_0.3s_ease-out]">
            <div className="text-green-500 mb-4 flex justify-center"><CheckCircle className="w-16 h-16" /></div>
            <h2 className="text-2xl font-bold mb-2">Terima Kasih!</h2>
            <p className="text-gray-600 mb-6">Pesanan anda berjaya direkodkan. Sila semak WhatsApp anda untuk pengesahan.</p>
            <button type="button" onClick={() => setSuccessModal(false)} className="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-full font-bold w-full transition-colors shadow-lg">Tutup</button>
          </div>
        </div>
      )}
    </div>
  );
}

