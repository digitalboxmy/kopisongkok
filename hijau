function CheckoutView({ cart, cartTotal, goBack, completeOrder, storeSettings }) {
  const [name, setName] = useState('');
  const [phone, setPhone] = useState('');
  const [address, setAddress] = useState('');
  const [region, setRegion] = useState('SM');
  const [receiptPreview, setReceiptPreview] = useState(null);
  const [formError, setFormError] = useState('');

  // Dinamik calculation berdasarkan tetapan admin
  const activePostage = region === 'SM' ? storeSettings.feeSM : storeSettings.feeSS;
  const shippingFee = cartTotal >= storeSettings.freeThreshold ? 0 : activePostage;
  const grandTotal = cartTotal + shippingFee;

  const handleReceiptUpload = (e) => {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onloadend = () => setReceiptPreview(reader.result);
      reader.readAsDataURL(file);
    }
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    if (!name || !phone || !address) return;
    if (!receiptPreview) {
      setFormError('Sila muat naik resit/bukti pembayaran terlebih dahulu sebelum sahkan pesanan.');
      return;
    }
    setFormError('');
    completeOrder({ name, phone, address, region, paymentMethod: 'qr', grandTotal, receiptBase64: receiptPreview });
  };

  return (
    <div className="max-w-6xl mx-auto px-4 py-8 md:py-12 flex flex-col lg:flex-row gap-8">
      <div className="flex-1">
        <button type="button" onClick={goBack} className="text-gray-500 hover:text-green-600 mb-6 flex items-center font-medium bg-white px-4 py-2 rounded-full border border-gray-200 shadow-sm w-fit">
          ← Kembali ke Kedai
        </button>
        
        <div className="bg-white p-6 md:p-8 rounded-3xl shadow-sm border border-gray-100 mb-8">
          <h2 className="text-2xl font-bold mb-6 flex items-center"><Package className="mr-3 text-green-600"/> Maklumat Penghantaran</h2>
          <form id="checkoutForm" onSubmit={handleSubmit} className="space-y-5">
