            <div className="mt-4 border-t border-gray-200 pt-4 text-left">
              <label className="block text-sm font-bold text-gray-800 mb-2 text-center">Sila Upload Resit (Wajib) <span className="text-red-500">*</span></label>
              <label className={`flex flex-col items-center justify-center w-full h-32 border-2 border-dashed rounded-xl cursor-pointer bg-white hover:bg-gray-50 overflow-hidden ${receiptPreview ? 'border-green-500' : 'border-red-300'}`}>
